
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
FLASK_SECRET_KEY=replace_with_a_random_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SENDER_EMAIL=yourname@gmail.com
TEST_RECIPIENT_EMAIL=your_other_email@gmail.com

APP_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_PASSING_SCORE=90
EMAIL_ENABLED=false
